{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client","vitest/globals"],
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"],
      "$app": ["./.svelte-kit/runtime/app"],
      "$app/*": ["./.svelte-kit/runtime/app/*"]
    }
  },
  "include": ["src/**/*.d.ts", "src/**/*.ts", "src/**/*.svelte"]
}